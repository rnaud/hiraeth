{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memento",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // The game has no server API: Workers serves the Vite output directly.
  // Keep all three HTML entry points; missing assets must remain real 404s.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
