<?xml version="1.0" encoding="utf-8"?>
<!-- Hiraeth for Xbox (Developer Mode), docs/systems/xbox.md. The build rewrites Identity's Version (the game's
     version and build: scripts/xbox-package.mjs uwpVersion) and Publisher (the signing certificate's subject). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity Name="rnaud.Hiraeth" Publisher="CN=Hiraeth Xbox Dev" Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="6c1f3c2e-4b8a-4f7e-9a51-2d0e8f3b7a10" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Hiraeth</DisplayName>
    <PublisherDisplayName>rnaud</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Hiraeth.App">
      <uap:VisualElements
        DisplayName="Hiraeth"
        Description="Hiraeth: an exploration game drawn in the style of Moebius"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Hiraeth" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#F7ECD2" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
