<!-- The game: one full-screen WebView2 (MainPage.xaml.cs). Status shows only when the web view can't start. -->
<Page
    x:Class="Hiraeth.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#F7ECD2"
    RequiresPointer="Never">
    <Grid Background="#F7ECD2">
        <controls:WebView2 x:Name="Web" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="True" RequiresPointer="Never"
                             IsFocusEngagementEnabled="False" UseSystemFocusVisuals="False" />
        <TextBlock x:Name="Status" Visibility="Collapsed" Margin="96,54" TextWrapping="Wrap"
                   Foreground="#2B211F" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</Page>
