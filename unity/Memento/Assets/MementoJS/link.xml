<!-- The JS bridge's players (IL2CPP): what the bundle reaches by reflection stays whole. Puerts' own
     assemblies (JsRuntime.cs finds its JsEnv by name; the V8 backend is found the same way) and the
     bridge's host, whose static methods the script calls through Puerts (CS.Memento.Bridge.BridgeHost). -->
<linker>
  <assembly fullname="com.tencent.puerts.core" preserve="all" />
  <assembly fullname="com.tencent.puerts.v8" preserve="all" />
  <assembly fullname="Assembly-CSharp">
    <namespace fullname="Memento.Bridge" preserve="all" />
  </assembly>
</linker>
