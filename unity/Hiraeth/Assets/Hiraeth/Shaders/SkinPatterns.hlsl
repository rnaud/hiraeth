  float2 s13_whFar(float3 sp, float3 rd, float rn, float D, float d0) {
    float3 f = sp + rd * (D / rn);
    float2 c = float2(0.0, 4.5), qf = float2(dot(f, (_SkinData[1].xyz)), f.y);
    return c + (qf - c) * d0 / (d0 + D);
  }
