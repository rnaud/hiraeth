void s12_wall(float3 vWorldPos, float3 vObjPos, float3 vObjNormal, float2 vTextureUV, float4 skFragCoord, float3 n, float3 uColor, inout float3 albedoOut, inout float inkOut, inout float emitOut)
{

    float3 whP = vWorldPos - (_SkinData[0].xyz);
    float whInkV = 0.0, whGlow = 0.0;
    float3 albedo = uColor;
    {
      bool side = abs(n.y) < 0.65;
      float P = side ? (_SkinData[9].xy).x : 4.8, Hc = side ? (_SkinData[9].xy).y : 4.8;
      float2 q = side ? float2(s12_whAlong(whP, n), whP.y - (whP.y < -3.0 ? -24.0 : 0.0)) : whP.xz;
      // the slabs: columns P wide, courses Hc high, each column's courses set off its own way
      float col = floor(q.x / P), oy = side ? s12_whH(float2(col, 3.3)) * Hc : 0.0;
      float2 c = float2(q.x / P, (q.y + oy) / Hc), cell = floor(c), f = frac(c);
      float2 fw2 = fwidth(q), fq = fwidth(c);
      float fw = max(max(fw2.x, fw2.y), 1e-5);
      float2 em = min(f, 1.0 - f) / max(fq, 1e-5);
      float far = smoothstep(0.08, 0.2, max(fq.x, fq.y));
      float tone = 0.93 + 0.12 * s12_whH(cell + 11.0) - 0.07 * step(0.86, s12_whH(cell + 2.0));
      albedo = uColor * lerp(tone, 1.0, far);
      whInkV = s12_whInk(min(em.x, em.y)) * 0.5 * (1.0 - far);
      if (_WearLite < 0.5) {
        // the chamfers: a lit lip along each slab's top and left edge, a shaded one along its bottom and right
        float b = 0.07;
        float2 m = f * float2(P, Hc), M2 = (1.0 - f) * float2(P, Hc);
        float lit = max(1.0 - smoothstep(b - fw, b, M2.y), 1.0 - smoothstep(b - fw, b, m.x));
        float shd = max(1.0 - smoothstep(b - fw, b, m.y), 1.0 - smoothstep(b - fw, b, M2.x));
        float k = (1.0 - smoothstep(0.4, 1.0, fw / b));
        albedo = lerp(albedo, (_SkinData[8].xyz), lit * k * 0.8);
        albedo = lerp(albedo, (_SkinData[7].xyz), shd * k * 0.8 * (1.0 - lit));
      }
      if (side) {
        float2 L = s12_whWallLine(q, P);
        float d = L.x;
        // (a foot line_ along the wall in some stretches)
        if (_WearLite < 0.5 && s12_whH(float2(floor(q.x / 13.0), 1.9)) < 0.5) d = min(d, abs(q.y - 0.45));
        float ring = abs(L.y - 0.22), dot0 = L.y - 0.07;
