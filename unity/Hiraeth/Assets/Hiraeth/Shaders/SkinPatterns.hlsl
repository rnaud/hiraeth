  float s13_whSegT(float2 p, float2 a, float2 b, float w) { float2 pa = p - a, ba = b - a; float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0); return length(pa - ba * h) - w * (1.0 - h); }

void s13_sea(float3 vWorldPos, float3 vObjPos, float3 vObjNormal, float2 vTextureUV, float4 skFragCoord, float3 n, float3 uColor, inout float3 albedoOut, inout float inkOut, inout float emitOut)
{

    float3 albedo = uColor;
    float whInkV = 0.0;
    {
      float3 sp = vWorldPos - (_SkinData[0].xyz);
      float2 q = float2(dot(sp, (_SkinData[1].xyz)), sp.y);
      float W = (_SkinData[2].xy).x, Hh = (_SkinData[2].xy).y, k = clamp(q.y / Hh, 0.0, 1.0);
      float2 fw2 = fwidth(q);
