      // shafts from above, slanted, soft-edged
      float sh = frac((q.x * 0.9 + q.y * 0.45) / 6.3 + 0.25 * vnoise(float2(q.x * 0.05, 3.0)));
      float band = smoothstep(0.55, 0.68, sh) * (1.0 - smoothstep(0.78, 0.92, sh));
      albedo += float3(0.08, 0.15, 0.18) * band * smoothstep(0.1, 1.0, k);
