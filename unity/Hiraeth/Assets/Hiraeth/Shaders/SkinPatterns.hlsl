        whGlow = cov * pulse;
        whInkV *= 1.0 - cov;
      }
    }
  
  albedoOut = albedo; inkOut = whInkV; emitOut = whGlow;
}
void s12_floor(float3 vWorldPos, float3 vObjPos, float3 vObjNormal, float2 vTextureUV, float4 skFragCoord, float3 n, float3 uColor, inout float3 albedoOut, inout float inkOut, inout float emitOut)
{

    float3 whP = vWorldPos - (_SkinData[0].xyz);
    float whInkV = 0.0, whGlow = 0.0;
    float3 albedo = uColor;
    {
      bool top = abs(n.y) > 0.65;
      float2 q = top ? whP.xz : float2(abs(n.x) > abs(n.z) ? whP.z : whP.x, whP.y);
      float2 c = q / (_SkinData[9].xy), cell = floor(c), f = frac(c);
      float2 fw2 = fwidth(q), fq = fwidth(c);
      float fw = max(max(fw2.x, fw2.y), 1e-5);
      float2 em = min(f, 1.0 - f) / max(fq, 1e-5);
      float far = smoothstep(0.08, 0.2, max(fq.x, fq.y));
      albedo = uColor * lerp(0.94 + 0.1 * s12_whH(cell + 5.0), 1.0, far);
      whInkV = s12_whInk(min(em.x, em.y)) * 0.45 * (1.0 - far);
      if (_WearLite < 0.5) {
        float b = 0.06;
        float2 m = f * (_SkinData[9].xy), M2 = (1.0 - f) * (_SkinData[9].xy);
        float lit = max(1.0 - smoothstep(b - fw, b, M2.y), 1.0 - smoothstep(b - fw, b, m.x));
        float shd = max(1.0 - smoothstep(b - fw, b, m.y), 1.0 - smoothstep(b - fw, b, M2.x));
        float k = (1.0 - smoothstep(0.4, 1.0, fw / b));
        albedo = lerp(albedo, (_SkinData[8].xyz), lit * k * 0.55);
        albedo = lerp(albedo, (_SkinData[7].xyz), shd * k * 0.55 * (1.0 - lit));
      }
      if (top) {
        // the lines along the plates' seams: rows along x (every 4 plates) and, but on the lighter presets, along z
        float2 A = s12_whFloorLine(q, (_SkinData[9].xy).y * 4.0, (_SkinData[9].xy).x * 3.0, (_SkinData[9].xy).y, 1.3);
        if (_WearLite < 0.5) { float2 B = s12_whFloorLine(q.yx, (_SkinData[9].xy).x * 4.0, (_SkinData[9].xy).y * 4.0, (_SkinData[9].xy).x, 7.9); A = min(A, B); }
