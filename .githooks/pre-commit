#!/bin/sh
# One selector for staged changes and CI. Unknown selection falls back to the full suite.
# FULL_TESTS=1 explicitly requests all tests. The normal hook is never bypassed.
set -eu
# Tests execute the working tree: never certify different staged bytes.
if ! git diff --quiet --ignore-submodules --; then
  echo 'pre-commit: unstaged tracked changes differ from the index; stage or preserve them before testing this commit' >&2
  exit 1
fi
selection=$(mktemp)
trap 'rm -f "$selection"' EXIT HUP INT TERM
if [ -n "${FULL_TESTS:-}" ]; then
  node scripts/affected-tests.mjs --staged --all --json > "$selection" || printf 'null\n' > "$selection"
else
  node scripts/affected-tests.mjs --staged --json > "$selection" || printf 'null\n' > "$selection"
fi
# Use an argv array, never shell word-splitting or eval. A malformed/failed selection means all tests.
node --input-type=module - "$selection" <<'JS'
import {readFileSync,readdirSync} from 'node:fs';
import {spawnSync} from 'node:child_process';
const all=readdirSync('tests').filter(f=>f.endsWith('.test.js')).sort().map(f=>'tests/'+f);
let tests;try{tests=JSON.parse(readFileSync(process.argv[2],'utf8'));}catch{}
if(!Array.isArray(tests)||tests.some(f=>typeof f!=='string'||!all.includes(f)))tests=all;
tests=[...new Set(tests)];
if(!tests.length){console.log('pre-commit: verified empty affected test set');process.exit(0);}
const n=process.env.TEST_CONCURRENCY??'2';
if(!/^[1-9][0-9]*$/.test(n))throw Error('Invalid TEST_CONCURRENCY');
console.log(`pre-commit: ${tests.length} affected test files; concurrency ${n}`);
// Git exports its repository/index context to hooks. Tests create disposable repositories;
// preserve the context above for staged selection, then isolate all test subprocesses.
const testEnv=Object.fromEntries(Object.entries(process.env).filter(([key])=>!key.startsWith('GIT_')));
const r=spawnSync(process.execPath,['--test',`--test-concurrency=${n}`,...tests],{stdio:'inherit',env:testEnv});
if(r.error)throw r.error;
process.exit(r.status??1);
JS
