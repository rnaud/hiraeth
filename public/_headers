# Cloudflare Workers static assets: headers by path (docs/cloudflare.md). The recorded themes are read by
# the games on devices (another origin: 127.0.0.1:41730, moebius://game), which fetch and keep them
# (src/music-store.js); fetch() needs CORS for that.
/music/*
  Access-Control-Allow-Origin: *
# The references page's index (scripts/references-site.mjs): a game on a device opens references.html from its
# own bundle and reads the index from the site.
/references/*
  Access-Control-Allow-Origin: *
